{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/*.p12)",
      "Edit(**/*.pfx)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(~/.aws/**)",
      "Read(~/.pypirc)",
      "Edit(~/.pypirc)",
      "Read(~/.npmrc)",
      "Edit(~/.npmrc)",
      "Read(~/.docker/config.json)",
      "Edit(~/.docker/config.json)",
      "Read(~/.config/pypoetry/auth.toml)",
      "Edit(~/.config/pypoetry/auth.toml)",
      "Edit(**/poetry.lock)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(rm -rf *)",
      "Bash(git commit *--no-verify*)",
      "Bash(* --no-verify*)",
      "Bash(poetry publish*)",
      "Bash(make publish*)",
      "Bash(gh release create*)",
      "Bash(gh workflow run*)"
    ]
  }
}
