{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(/**/.env)",
      "Read(/**/.env.local)",
      "Read(/**/.env.*.local)",
      "Read(/**/.env.prod*)",
      "Read(/**/.env.dev*)",
      "Read(/**/.env.stag*)",
      "Read(/**/.env.uat*)",
      "Read(/**/.env.qa*)",
      "Read(/**/.env.test*)",
      "Read(/**/*.env)",
      "Read(/**/.envrc)",
      "Edit(/**/.env)",
      "Edit(/**/.env.local)",
      "Edit(/**/.env.*.local)",
      "Edit(/**/.env.prod*)",
      "Edit(/**/.env.dev*)",
      "Edit(/**/.env.stag*)",
      "Edit(/**/.env.uat*)",
      "Edit(/**/.env.qa*)",
      "Edit(/**/.env.test*)",
      "Edit(/**/*.env)",
      "Edit(/**/.envrc)",
      "Read(/**/*.pem)",
      "Read(/**/*.key)",
      "Read(/**/*.p12)",
      "Read(/**/*.pfx)",
      "Edit(/**/*.pem)",
      "Edit(/**/*.key)",
      "Edit(/**/*.p12)",
      "Edit(/**/*.pfx)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(~/.aws/**)",
      "Read(~/.pypirc)",
      "Edit(~/.pypirc)",
      "Read(~/.npmrc)",
      "Edit(~/.npmrc)",
      "Read(~/.docker/config.json)",
      "Edit(~/.docker/config.json)",
      "Read(~/.config/pypoetry/auth.toml)",
      "Edit(~/.config/pypoetry/auth.toml)",
      "Edit(/**/poetry.lock)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(rm -rf *)",
      "Bash(git commit *--no-verify*)",
      "Bash(* --no-verify*)",
      "Bash(poetry publish*)",
      "Bash(make publish*)",
      "Bash(gh release create*)",
      "Bash(gh workflow run*)"
    ],
    "ask": []
  }
}
